GROQ_API_KEY=your_secret_token_here
GROQ_MODEL=llama-3.3-70b-versatile

API_TOKEN=your_secret_token_here
RATE_LIMIT=5/minute

# Frontend (Vite reads VITE_ prefix)
VITE_API_TOKEN=your_secret_token_here

# ── RAG / Vector search ────────────────────────────────────────────────────
# Sentence-Transformers model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index strategy: flat | ivf | hnsw
#   flat → exact brute-force (best for small datasets, always accurate)
#   ivf  → inverted file index (fast on large datasets, needs training)
#   hnsw → graph-based ANN (fast queries, high recall, no training needed)
INDEX_TYPE=flat

# Vector store backend: faiss | qdrant
VECTOR_DB=faiss

# Where to persist the FAISS index between restarts
INDEX_PERSIST_PATH=./faiss_store

# ── Qdrant (only needed when VECTOR_DB=qdrant) ────────────────────────────
# Start Qdrant with: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_docs
